  "source_excerpt": "RespinFeatureManager_ChCh.prototype.constructor=RespinFeatureManager_ChCh;function RespinFeatureManager_ChCh(){FOXLink.call(this);this.showButtons=null;this.hideButtons=null;this.enableInput=null;this.disableInput=null;this.lockReels=null;this.unlockReels=null;this.trailKey=\"trail\";this.reelsStatusKey=\"sr\";this.autoRespinDelay=5;this.resetTimerOnUserInput=false;this.indicatorSprites=null;this.rm=null;this.timer=0;this.reelsStatusValue=0;this.respinData=null;this.isRespin=false}\nRespinFeatureManager_ChCh.prototype.XTRegisterCallbacks=function(){FOXLink.prototype.XTRegisterCallbacks.call(this);XT.RegisterCallbackEvent(Vars.Evt_Internal_GameInit,this.OnGameInit,this);XT.RegisterCallbackEvent(Vars.Evt_Internal_ReelManager_SpinEnded,this.CheckForRespin,this);XT.RegisterCallbackEvent(Vars.Evt_ToServer_RequestSpin,this.UpdateSpinRequest,this,-69)};RespinFeatureManager_ChCh.prototype.HandleInitResponse=function(param){this.HandleResponse(param)};\nRespinFeatureManager_ChCh.prototype.HandleSpinResponse=function(param){this.HandleResponse(param)};RespinFeatureManager_ChCh.prototype.OnGameInit=function(){this.rm=XT.GetObject(Vars.ReelsManagerObject);this.CheckForRespin()};\nRespinFeatureManager_ChCh.prototype.CheckForRespin=function(){this.UpdateLockedReelsStatus();if(this.isRespin){if(XT.GetInt(Vars.AutoplaySpinsLeft)>=0)XT.SetInt(Vars.AutoplaySpinsLeft,XT.GetInt(Vars.AutoplaySpinsLeft)+1);XT.SetObject(Vars.ReceivedWinLines,[]);for(var reelIndex=0;reelIndex<this.rm.reels.length;reelIndex++)this.UpdateReelVisual(reelIndex);this.timer=this.autoRespinDelay;this.showButtons.Start();this.enableInput.Start()}else this.hideButtons.Start()};\nRespinFeatureManager_ChCh.prototype.UpdateSpinRequest=function(){if(this.isRespin){this.isRespin=false;this.timer=0;XT.SetBool(Vars.ManualRespin,false);this.disableInput.Start();var extraParam=new RequestExtraParams;extraParam.dict[\"ind\"]=this.reelsStatusValue.toString();XT.SetObject(Vars.ToServer_RequestExtraParams,extraParam)}var reelsStopOrder=XT.GetObject(Vars.ReelsStopOrder);var currentReelStopIndex=reelsStopOrder.length-1;for(var i=this.rm.reels.length-1;i>=0;i--)if(this.rm.validateReelSpin[i]){reelsStopOrder[currentReelStopIndex]=\ni;currentReelStopIndex--}XT.SetObject(Vars.ReelsStopOrder,reelsStopOrder)};\nRespinFeatureManager_ChCh.prototype.HandleResponse=function(data){this.respinData=XT.GetObject(Vars.RespinData);this.isRespin=this.respinData!=null&&!this.respinData.IsDone;XT.SetBool(Vars.ManualRespin,this.isRespin);XT.SetBool(Vars.AllowBetChange,!this.isRespin);this.reelsStatusValue=0;if(data[this.trailKey]!=undefined){var dataValues=data[this.trailKey].split(\";\");for(var i=0;i<dataValues.length;i++){var dataValue=dataValues[i].split(\"~\");if(dataValue[0]==this.reelsStatusKey)this.reelsStatusValue=\n_number.otoi(dataValue[1])}}};RespinFeatureManager_ChCh.prototype.UpdateLockedReelsStatus=function(){for(var reelIndex=0;reelIndex<this.rm.reels.length;reelIndex++){var reelMask=1<<this.rm.reels.length-(reelIndex+1);if(this.isRespin)this.rm.validateReelSpin[reelIndex]=(reelMask&this.reelsStatusValue)!=0;else this.rm.validateReelSpin[reelIndex]=true}};\nRespinFeatureManager_ChCh.prototype.ChangeReelStatus=function(reelIndex){if(this.resetTimerOnUserInput)this.timer=this.autoRespinDelay;this.rm.validateReelSpin[reelIndex]=!this.rm.validateReelSpin[reelIndex];var reelMask=1<<this.rm.reels.length-(reelIndex+1);this.reelsStatusValue^=reelMask;this.UpdateReelVisual(reelIndex)};\nRespinFeatureManager_ChCh.prototype.UpdateReelVisual=function(reelIndex){this.unlockReels[reelIndex].Stop();this.lockReels[reelIndex].Stop();if(this.rm.validateReelSpin[reelIndex])this.unlockReels[reelIndex].Start();else this.lockReels[reelIndex].Start()};RespinFeatureManager_ChCh.prototype.UpdateIndicatorSprites=function(_progress){for(var sIndex=0;sIndex<this.indicatorSprites.length;sIndex++){this.indicatorSprites[sIndex].fillAmount=_progress;this.indicatorSprites[sIndex].SetSpriteName(this.indicatorSprites[sIndex].spriteName)}};\nRespinFeatureManager_ChCh.prototype.Update=function(){if(this.timer>0){this.timer-=Time.deltaTime;this.UpdateIndicatorSprites(1-this.timer/this.autoRespinDelay)}if(this.timer<0){this.timer=0;XT.SetBool(Vars.ManualRespin,false)}};"
